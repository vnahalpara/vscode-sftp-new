{
  "name": "vaibhav-sftp-plus",
  "displayName": "Vaibhav SFTP Plus",
  "description": "SFTP/FTP file synchronization for VS Code (patched for current Node/VS Code).",
  "version": "1.32.0",
  "publisher": "vaibhavupdated",
  "author": "Vaibhav (https://github.com/vnahalpara)",
  "engines": {
    "vscode": "^1.67.0",
    "npm": ">=8.3"
  },
  "bugs": {
    "url": "https://github.com/vnahalpara/vscode-sftp-new/issues"
  },
  "homepage": "https://github.com/vnahalpara/vscode-sftp-new/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/vnahalpara/vscode-sftp-new.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "sync",
    "remote"
  ],
  "activationEvents": [
    "onCustomEditor:sftp.pdfViewer",
    "onCustomEditor:sftp.markdownViewer",
    "onCustomEditor:sftp.csvEditor",
    "onCommand:sftp.csv.openAsText",
    "onCommand:sftp.markdown.toPdf",
    "onCommand:sftp.markdown.openAsText",
    "onCommand:sftp.config",
    "workspaceContains:**/.vscode/sftp.json"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sftp.pdfViewer",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sftp.markdownViewer",
        "displayName": "Markdown Viewer",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "sftp.csvEditor",
        "displayName": "CSV Editor",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sftp",
          "title": "SFTP",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "sftp": [
        {
          "id": "remoteExplorer",
          "name": "Explorer",
          "when": "sftp.enabled"
        },
        {
          "id": "dbExplorer",
          "name": "Databases",
          "when": "sftp.enabled"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "sftp configuration",
      "properties": {
        "sftp.printDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "print debug log on sftp output channel.(reload vscode when change this)"
        },
        "sftp.debug": {
          "type": "boolean",
          "default": false,
          "description": "print debug log on sftp output channel.(reload vscode when change this)"
        },
        "sftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "\"Download\" instead of \"View Content\" when open file in Remote Explorer"
        },
        "sftp.showSizeInRemoteExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Show each file's size (B/KB/MB/GB) on the right side of its row in the Remote Explorer"
        },
        "sftp.configSearchDepth": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 10,
          "description": "How many folder levels below each workspace folder to search for .vscode/sftp.json. 0 searches only the workspace folder itself. Reload the window after changing."
        },
        "sftp.serverManager.browser": {
          "type": "string",
          "enum": [
            "chrome",
            "default",
            "chrome-app"
          ],
          "default": "chrome",
          "description": "How Manage Server opens the browser. 'chrome' opens a normal Chrome tab, 'default' uses your default browser, 'chrome-app' opens a standalone Chrome window with no address bar."
        },
        "sftp.serverManager.interval": {
          "type": "number",
          "default": 2000,
          "description": "Milliseconds between live metric samples."
        },
        "sftp.serverManager.slowInterval": {
          "type": "number",
          "default": 15000,
          "description": "Milliseconds between slow-lane samples (disks, processes, addresses)."
        },
        "sftp.serverManager.historyMinutes": {
          "type": "number",
          "default": 60,
          "description": "Minutes of metric history held in memory for the charts. History is not persisted across VS Code restarts."
        },
        "sftp.db.defaultLimit": {
          "type": "number",
          "default": 500,
          "description": "Row limit auto-appended to bare SELECT queries in the database SQL runner."
        },
        "sftp.clone.domainSuffix": {
          "type": "string",
          "default": ".local.com",
          "description": "Default local hostname suffix for site clones (hostname = <name><suffix>)."
        },
        "sftp.clone.sitesRoot": {
          "type": "string",
          "default": "~/Sites",
          "description": "Default parent folder for local site clones (path = <sitesRoot>/<name>)."
        },
        "sftp.clone.ssl": {
          "type": "object",
          "default": {},
          "properties": {
            "certPath": {
              "type": "string"
            },
            "keyPath": {
              "type": "string"
            }
          },
          "description": "Wildcard SSL cert/key for *.local.com used by generated local vhosts (set once)."
        },
        "sftp.clone.localDb": {
          "type": "object",
          "default": {
            "host": "127.0.0.1",
            "username": "root",
            "password": "root"
          },
          "properties": {
            "host": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          },
          "description": "Default local MySQL connection used when importing cloned databases."
        },
        "sftp.vpn.portRange": {
          "type": "string",
          "default": "21000-21999",
          "description": "Port range the VPN SOCKS proxy picks a deterministic port from."
        },
        "sftp.vpn.keepAlive": {
          "type": "boolean",
          "default": true,
          "description": "Leave the tunnel running when the last consumer releases it, so the next connection reuses it."
        }
      }
    },
