      "explorer/context": [
        {
          "command": "sftp.markdown.openAsText",
          "group": "navigation@10",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "sftp.markdown.toPdf",
          "group": "navigation@11",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "sftp.csv.openAsText",
          "group": "navigation@12",
          "when": "resourceExtname == .csv || resourceExtname == .tsv"
        }
      ],
      "editor/context": [
        {
          "command": "sftp.upload.file",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.download.file",
          "group": "sftp.trans@2",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "sftp.enabled && resourceScheme == remote"
        }
      ],
      "editor/title/context": [
        {
          "command": "sftp.markdown.openAsText",
          "group": "1_open@1",
          "when": "activeCustomEditorId == sftp.markdownViewer"
        },
        {
          "command": "sftp.markdown.toPdf",
          "group": "1_open@2",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "sftp.csv.openAsText",
          "group": "1_open@3",
          "when": "activeCustomEditorId == sftp.csvEditor"
        }
      ],
      "view/title": [
        {
          "command": "sftp.remoteExplorer.refresh",
          "when": "view == remoteExplorer",
          "group": "navigation"
        },
        {
          "command": "sftp.db.findTable",
          "when": "view == dbExplorer",
          "group": "navigation@1"
        },
        {
          "command": "sftp.db.refresh",
          "when": "view == dbExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sftp.db.findTable",
          "group": "inline",
          "when": "view == dbExplorer && viewItem == database"
        },
        {
          "command": "sftp.db.findTable",
          "group": "1_db@0",
          "when": "view == dbExplorer && (viewItem == connection || viewItem == database)"
        },
        {
          "command": "sftp.db.search",
          "group": "1_db@1",
          "when": "view == dbExplorer && (viewItem == connection || viewItem == database || viewItem == table)"
        },
        {
          "command": "sftp.db.newQuery",
          "group": "1_db@2",
          "when": "view == dbExplorer && viewItem == database"
        },
        {
          "command": "sftp.db.selectTop",
          "group": "1_db@3",
          "when": "view == dbExplorer && viewItem == table"
        },
        {
          "command": "sftp.db.showStructure",
          "group": "1_db@4",
          "when": "view == dbExplorer && viewItem == table"
        },
        {
          "command": "sftp.db.exportTable",
          "group": "2_export@0",
          "when": "view == dbExplorer && viewItem == table"
        },
        {
          "command": "sftp.db.exportDatabase",
          "group": "2_export@0",
          "when": "view == dbExplorer && viewItem == database"
        },
        {
          "command": "sftp.openConnectInTerminal",
          "group": "navigation@0",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "sftp.manageServer",
          "group": "navigation@1",
          "when": "view == remoteExplorer && viewItem == root"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && !config.sftp.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "sftp.viewContent",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem == file && config.sftp.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "sftp.revealInExplorer",
          "group": "2_files",
          "when": "view == remoteExplorer && viewItem != root && viewItem != workspaceGroup"
        },
        {
          "command": "sftp.upload.folder",
          "group": "3_trans@1",
          "alt": "sftp.forceUpload",
          "when": "sftp.enabled && viewItem != file && viewItem != workspaceGroup && viewItem != workspace"
        },
        {
          "command": "sftp.upload.file",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftp.upload.folder.to.allProfiles",
          "group": "3_trans@1",
          "alt": "sftp.forceUpload.to.allProfiles",
          "when": "sftp.enabled && viewItem != file && viewItem != workspaceGroup && viewItem != workspace"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "3_trans@1",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftp.download.folder",
          "group": "3_trans@2",
          "alt": "sftp.forceDownload",
          "when": "sftp.enabled && viewItem != file && viewItem != workspaceGroup && viewItem != workspace"
        },
        {
          "command": "sftp.download.file",
          "group": "3_trans@2",
          "when": "view == remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "sftp.delete.remote",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != root && viewItem != workspaceGroup"
        },
        {
          "command": "sftp.create.folder",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file && viewItem != workspaceGroup"
        },
        {
          "command": "sftp.goto.folder",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file && viewItem != workspaceGroup"
        },
        {
          "command": "sftp.getSize",
          "group": "5_info",
          "when": "view == remoteExplorer && viewItem != file && viewItem != workspaceGroup"
        },
        {
          "command": "sftp.createArchive",
          "group": "5_info",
          "when": "view == remoteExplorer && viewItem != file && viewItem != workspaceGroup"
        },
        {
          "command": "sftp.create.file",
          "group": "7_modification",
          "when": "view == remoteExplorer && viewItem != file && viewItem != workspaceGroup"
        }
      ],
      "editor/title": [
        {
          "command": "sftp.markdown.openAsText",
          "group": "navigation@1",
          "when": "activeCustomEditorId == sftp.markdownViewer"
        },
        {
          "command": "sftp.markdown.toPdf",
          "group": "navigation@2",
          "when": "activeCustomEditorId == sftp.markdownViewer || (resourceExtname == .md && editorLangId == markdown)"
        },
        {
          "command": "sftp.csv.openAsText",
          "group": "navigation@3",
          "when": "activeCustomEditorId == sftp.csvEditor"
        }
      ],
      "scm/title": [
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "sftp.upload.changedFiles",
          "group": "inline",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "inline",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sftp.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "sftp.enabled"
      },
      {
        "command": "sftp.db.runQuery",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "win": "ctrl+enter",
        "linux": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "remote",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:pdfjs && npm run build:webui && npm run build:csv && npm run compile",
    "build:pdfjs": "node scripts/copy-pdfjs.js",
    "compile": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "build:webui": "vite build --config webui/vite.config.ts",
    "watch:webui": "vite build --config webui/vite.config.ts --watch",
    "build:csv": "vite build --config webui/csv/vite.config.ts",
    "watch:csv": "vite build --config webui/csv/vite.config.ts --watch",
    "dev:webui": "node webui/dev/mock-server.js",
    "test": "jest",
    "package": "vsce package",
    "pub:debug": "rm -rf _debug && mkdir _debug && vsce package --out _debug/sftp-debug.vsix && cd _debug && git init && git commit --allow-empty -m 'update debug package' && git checkout -b debug-pacakge && cp ../INSTALL_DEBUG.md README.md  && git add . && git commit -am 'update debug package' && git push git@github.com:Natizyskunk/vscode-sftp.git debug-pacakge --force"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^23.3.5",
    "@types/lru-cache": "^4.1.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^9.6.51",
    "@types/vscode": "1.67",
    "@types/webpack-env": "^1.13.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "braces": ">=2.3.1",
    "glob-parent": ">=5.1.2",
    "jest": "^29.0.3",
    "json-schema": ">=0.4.0",
    "memfs": "^2.15.5",
    "merge": ">=2.1.1",
    "node-notifier": ">=8.0.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "rimraf": "^2.7.1",
    "set-value": "^4.0.1",
    "ts-loader": "^9.4.1",
    "tslint": "^6.1.3",
    "typescript": "^3.9.7",
    "typescript-tslint-plugin": "^1.0.2",
    "vite": "^6.4.3",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.7.0",
    "yargs-parser": "^20.2.4"
  },
  "dependencies": {
    "async": "^3.2.4",
    "fs-extra": "^10.1.0",
    "ftp": "^0.3.10",
    "ignore": "^5.1.4",
    "joi": "^10.6.0",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^4.1.3",
    "markdown-it": "^14.3.1",
    "mysql2": "^3.11.5",
    "p-queue": "2.4.2",
    "socks": "^2.8.3",
    "ssh-config": "^1.1.3",
    "ssh2": "^1.17.0",
    "tmp": "^0.2.1",
    "upath": "^2.0.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "@types/d3-array": "3.0.9"
  },
  "jest": {
    "verbose": true,
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": "<rootDir>/test/preprocessor.js"
    },
    "testMatch": [
      "<rootDir>/test/**/*.spec.js",
      "<rootDir>/**/*/__tests__/*.ts"
    ]
  }
}
